# انسخ هذا الملف وسميه .env واملأ القيم

SECRET_KEY=غيّر-هذا-لأي-نص-عشوائي-طويل
JWT_SECRET_KEY=غيّر-هذا-كذلك-لنص-ثاني-عشوائي

# Gmail SMTP (مجاني) — سوي "App Password" من إعدادات حساب Google
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# رابط الفرونت اند (يُستخدم داخل روابط الإيميلات)
FRONTEND_URL=http://localhost:5500

# المواقع المسموح لها تتواصل مع هذا الباك اند (مفصولة بفاصلة، بدون مسافات زايدة)
# لازم يحتوي رابط Netlify الحقيقي مالتك + أي رابط تجربة محلية تستخدمه
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5500

# اتركه فاضي عشان يستخدم SQLite تلقائي، أو حط رابط قاعدة بيانات ثانية
# DATABASE_URL=
